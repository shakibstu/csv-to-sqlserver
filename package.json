{
  "name": "csv-to-sqlserver",
  "displayName": "CSV to SQL Server",
  "icon": "media/icon.png",
  "description": "Import CSV files into SQL Server with validated mappings, exact numeric conversion, and transactional loading.",
  "version": "0.2.0",
  "publisher": "your-publisher",
  "repository": {
    "type": "git",
    "url": "https://github.com/shakibstu/csv-to-sqlserver.git"
  },
  "homepage": "https://github.com/shakibstu/csv-to-sqlserver#readme",
  "bugs": {
    "url": "https://github.com/shakibstu/csv-to-sqlserver/issues"
  },
  "engines": {
    "vscode": "^1.101.0",
    "node": ">=22"
  },
  "license": "MIT",
  "categories": [
    "Other"
  ],
  "keywords": [
    "sql",
    "sql server",
    "mssql",
    "csv",
    "import",
    "bulk",
    "azure sql",
    "managed identity"
  ],
  "activationEvents": [
    "onCommand:csvToSqlServer.importCsv",
    "onCommand:csvToSqlServer.importCsvFromExplorer"
  ],
  "main": "./out/extension.js",
  "extensionDependencies": [
    "ms-mssql.mssql"
  ],
  "contributes": {
    "commands": [
      {
        "command": "csvToSqlServer.importCsv",
        "title": "SQL Server: Import CSV..."
      },
      {
        "command": "csvToSqlServer.importCsvFromExplorer",
        "title": "Import CSV to SQL Server..."
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "csvToSqlServer.importCsvFromExplorer",
          "when": "resourceExtname == .csv",
          "group": "7_modification@10"
        }
      ],
      "commandPalette": [
        {
          "command": "csvToSqlServer.importCsvFromExplorer",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "CSV to SQL Server",
      "properties": {
        "csvToSqlServer.defaultBatchSize": {
          "type": "number",
          "default": 1000,
          "minimum": 1,
          "maximum": 10000,
          "description": "Default number of rows per bulk-insert batch."
        },
        "csvToSqlServer.inferSampleSize": {
          "type": "number",
          "default": 1000,
          "minimum": 10,
          "description": "Number of rows sampled to infer column types when creating a new table."
        },
        "csvToSqlServer.defaultSchema": {
          "type": "string",
          "default": "dbo",
          "description": "Default target schema name."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm test",
    "compile": "tsc -p ./",
    "watch": "tsc -w -p ./",
    "check": "tsc -p ./ --noEmit",
    "test": "npm run compile && node --test tests/*.test.cjs",
    "test:integration": "npm run compile && node --test tests/integration.test.cjs",
    "package": "vsce package --allow-missing-repository"
  },
  "devDependencies": {
    "@types/mssql": "^12.3.0",
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.101.0",
    "@vscode/vsce": "^4.0.0",
    "typescript": "^5.4.0"
  },
  "dependencies": {
    "csv-parse": "^7.0.3",
    "mssql": "^12.7.4"
  }
}
